{
  "name": "site-factory",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "vitest run --pool=threads",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json && npm run build --workspace @site-factory/desktop",
    "test:e2e": "playwright test",
    "tauri:dev": "npm run build && node scripts/desktop-dev.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/css-tree": "3.2.0",
    "@types/node": "24.10.0",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "jose": "6.2.13",
    "pg": "8.23.1"
  }
}
